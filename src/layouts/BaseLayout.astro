---
// Vite rewrites these to the hashed build URLs, so the preload tags below
// point at the exact files the stylesheet will request.
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import poppins600 from '@fontsource/poppins/files/poppins-latin-600-normal.woff2?url';
import poppins700 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url';

import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '../styles/global.css';

import { profile, seo } from '../data/site';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  /** Path relative to the site root, e.g. "/" or "/404". */
  path?: string;
  noindex?: boolean;
}

const { title = seo.title, description = seo.description, path = '/', noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname || path, Astro.site).href;
const ogImage = new URL(withBase('og-image.png'), Astro.site).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  description: seo.description,
  email: `mailto:${profile.email}`,
  telephone: profile.phoneHref,
  url: canonical,
  image: ogImage,
  sameAs: [profile.github],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Sagbayan',
    addressRegion: 'Bohol',
    addressCountry: 'PH',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Carmen Municipal College',
    address: { '@type': 'PostalAddress', addressLocality: 'Carmen', addressRegion: 'Bohol', addressCountry: 'PH' },
  },
  worksFor: { '@type': 'Organization', name: 'YS Construction Inc.' },
  knowsAbout: [
    'AI workflow automation',
    'AI agents and chatbots',
    'Laravel',
    'PHP',
    'MySQL',
    'Tailwind CSS',
    'JavaScript',
    'Web accessibility',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${profile.name} — Portfolio`,
  url: new URL(withBase('/'), Astro.site).href,
  inLanguage: 'en',
  author: { '@type': 'Person', name: profile.name },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={seo.keywords.join(', ')} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

    <!-- Fetch the fonts with the stylesheet rather than after it, so the
         swap lands before first paint instead of reflowing the page. -->
    <link rel="preload" as="font" type="font/woff2" href={poppins400} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={poppins600} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={poppins700} crossorigin="anonymous" />

    <meta name="theme-color" content="#12142a" />
    <meta name="color-scheme" content="light" />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={`${profile.name} — Portfolio`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
    <meta property="og:locale" content="en_PH" />
    <meta property="profile:first_name" content="Jammael" />
    <meta property="profile:last_name" content="Magallanes" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('site.webmanifest')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />

    <!-- Restore the reader's saved text size before first paint, so nothing jumps. -->
    <script is:inline>
      (function () {
        try {
          var scale = localStorage.getItem('jm-font-scale');
          if (scale) document.documentElement.style.setProperty('--font-scale', scale);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
